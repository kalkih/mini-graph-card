/**
 * Tests for convertStateByMap().
 *
 * The file is disabled (renamed to *.dis) & thus is not used during a build process;
 * remove the "dis" extension to use it locally in your VSCode devcontainer.
 */

import { expect, describe, it, beforeEach } from 'vitest';
import { convertStateByMap } from '../src/others';
import type { StateMapType } from './types/stateMapTypes';

describe("convertStateByMap()", () => {
  describe('keep_values=false/undefined', () => {
    let stateMapConfig: StateMapType = {};

    describe('strings in mapping', () => {
      beforeEach(() => {
        stateMapConfig.keep_values = false;
        stateMapConfig.map = [
          { value: 'red', label: 'Red' },
          { value: 'green', label: 'Green' },
          { value: 'blue', label: 'Blue' },
        ];
      });

      it('convert to index', () => {
        const res = { state: 'green' };
        convertStateByMap(res, stateMapConfig);
        expect(res.state).toEqual(1);
      });

      it('no mapping, convert to NaN', () => {
        const res = { state: 'cyan' };
        convertStateByMap(res, stateMapConfig);
        expect(Number.isNaN(res.state)).toBe(true);
      });

      it('unavailable, no mapping, convert to NaN', () => {
        const res = { state: 'unavailable' };
        convertStateByMap(res, stateMapConfig);
        expect(Number.isNaN(res.state)).toBe(true);
      });

      it('unavailable, use mapping', () => {
        stateMapConfig.map = [
          ...stateMapConfig.map!,
          {value: 'unavailable'},
        ];
        const res = { state: 'unavailable' };
        convertStateByMap(res, stateMapConfig);
        expect(res.state).toEqual(3);
      });
    });

    describe('numbers in mapping', () => {
      beforeEach(() => {
        stateMapConfig.keep_values = false;
        stateMapConfig.map = [
          { value: 11, label: 'Red' },
          { value: 12, label: 'Green' },
          { value: 13, label: 'Blue' },
        ];
      });

      it('convert to index', () => {
        const res = { state: '11' };
        convertStateByMap(res, stateMapConfig);
        expect(res.state).toEqual(0);
      });

      it('no mapping, convert to NaN', () => {
        const res = { state: '14' };
        convertStateByMap(res, stateMapConfig);
        expect(Number.isNaN(res.state)).toBe(true);
      });

      it('unavailable, no mapping, convert to NaN', () => {
        const res = { state: 'unavailable' };
        convertStateByMap(res, stateMapConfig);
        expect(Number.isNaN(res.state)).toBe(true);
      });

      it('unavailable, use mapping', () => {
        stateMapConfig.map = [
          ...stateMapConfig.map!,
          {value: 'unavailable'},
        ];
        const res = { state: 'unavailable' };
        convertStateByMap(res, stateMapConfig);
        expect(res.state).toEqual(3);
      });
    });
  });
  ///////////////////////////////////////////////////////////////////////////////////////

  describe('keep_values=true', () => {
    let stateMapConfig: StateMapType = {};

    beforeEach(() => {
      stateMapConfig.keep_values = true;
      stateMapConfig.map = [
        { value: '10', label: 'Red' },
        { value: '11', label: 'Green' },
        { value: '12', label: 'Blue' },
      ];
    });

    it('use mapping', () => {
      const res = { state: '10' };
      convertStateByMap(res, stateMapConfig);
      expect(res.state).toEqual('10');
    });

    it('no mapping', () => {
      const res = { state: '9' };
      convertStateByMap(res, stateMapConfig);
      expect(res.state).toEqual('9');
    });

    it('unavailable, no mapping', () => {
      const res = { state: 'unavailable' };
      convertStateByMap(res, stateMapConfig);
      expect(res.state).toEqual('unavailable');
    });
  });

  ///////////////////////////////////////////////////////////////////////////////////////

  describe('others', () => {
    let stateMapConfig: StateMapType = {};

    beforeEach(() => {
      stateMapConfig.map = [];
    });

    it('state_map.map is empty', () => {
      const res = { state: 'xxx' };
      convertStateByMap(res, stateMapConfig);
      expect(res.state).toEqual('xxx');
    });

    it('state_map.map is empty, keep_values=true', () => {
      stateMapConfig.keep_values = true;
      const res = { state: 'xxx' };
      convertStateByMap(res, stateMapConfig);
      expect(res.state).toEqual('xxx');
    });
  });
});
