/**
 * Tests for checkColorThresholds().
 *
 * The file is disabled (renamed to *.dis) & thus is not used during a build process;
 * remove the "dis" extension to use it locally in your VSCode devcontainer.
 */

import { expect, describe, it } from 'vitest';
import { checkColorThresholds } from '../src/checkOption';
import { OTHER_OPTIONS } from './otherOptions';

const COLORS: string[] = [
  "red",
  "#ff00ff",
  "var(--red-color)",
];

const VARIANTS: any[] = [
  {
    description: 'other options are untouched, color_thresholds is []',
    config: { color_thresholds: [], ...OTHER_OPTIONS },
    expected: { color_thresholds: [], ...OTHER_OPTIONS },
  },
  {
    description: 'other options are untouched, color_thresholds is undefined',
    config: { ...OTHER_OPTIONS },
    expected: { ...OTHER_OPTIONS },
  },
  {
    description: 'other options are untouched, color_thresholds is explicitly undefined',
    config: { color_thresholds: undefined, ...OTHER_OPTIONS },
    expected: { color_thresholds: undefined, ...OTHER_OPTIONS },
  },
  {
    description: 'other options are untouched, color_thresholds is null',
    config: { color_thresholds: null, ...OTHER_OPTIONS },
    expected: { color_thresholds: null, ...OTHER_OPTIONS },
  },
  //////////////////////////////////////
  {
    description: 'color_thresholds is a number -> unsetting to []',
    config: { color_thresholds: 123 },
    expected: { color_thresholds: [] },
  },
  {
    description: 'color_thresholds is a string -> unsetting to []',
    config: { color_thresholds: 'abc' },
    expected: { color_thresholds: [] },
  },
  {
    description: 'color_thresholds is a dict -> unsetting to []',
    config: { color_thresholds: {abc: 123} },
    expected: { color_thresholds: [] },
  },
  //////////////////////////////////////
  {
    description: 'entry is undefined',
    config: { color_thresholds: ['red', undefined] },
    expected: { color_thresholds: [{ color: 'red' }] },
  },
  {
    description: 'entry is null',
    config: { color_thresholds: ['red', null] },
    expected: { color_thresholds: [{ color: 'red' }] },
  },
  {
    description: 'entry is wrong (a number)',
    config: { color_thresholds: ['red', 123] },
    expected: { color_thresholds: [{ color: 'red' }] },
  },
  {
    description: 'entry is wrong (an array)',
    config: { color_thresholds: ['red', [123, 456]] },
    expected: { color_thresholds: [{ color: 'red' }] },
  },
  {
    description: 'entry is wrong (an empty array)',
    config: { color_thresholds: ['red', []] },
    expected: { color_thresholds: [{ color: 'red' }] },
  },
  //////////////////////////////////////
  {
    description: 'color is missing',
    config: { color_thresholds: ['red', {value: 123}] },
    expected: { color_thresholds: [{ color: 'red' }, {color: 'var(--primary-text-color)', value: 123}] },
  },
  {
    description: 'color is undefined',
    config: { color_thresholds: ['red', {color: undefined, value: 123}] },
    expected: { color_thresholds: [{ color: 'red' }, {color: 'var(--primary-text-color)', value: 123}] },
  },
  {
    description: 'color is a number',
    config: { color_thresholds: ['red', {color: 123, value: 123}] },
    expected: { color_thresholds: [{ color: 'red' }, {color: 'var(--primary-text-color)', value: 123}] },
  },
  {
    description: 'color is a dict',
    config: { color_thresholds: ['red', {color: {abc: 123}, value: 123}] },
    expected: { color_thresholds: [{ color: 'red' }, {color: 'var(--primary-text-color)', value: 123}] },
  },
  {
    description: 'color is an array ',
    config: { color_thresholds: ['red', {color: ['abc', 'def'], value: 123}] },
    expected: { color_thresholds: [{ color: 'red' }, {color: 'var(--primary-text-color)', value: 123}] },
  },
  //////////////////////////////////////
  {
    description: 'value is undefined',
    config: { color_thresholds: ['red', {color: 'red', value: undefined}] },
    expected: { color_thresholds: [{color: 'red'}, {color: 'red'}] },
  },
  {
    description: 'value is null',
    config: { color_thresholds: ['red', {color: 'red', value: null}] },
    expected: { color_thresholds: [{color: 'red'}, {color: 'red'}] },
  },
  {
    description: 'value is a string',
    config: { color_thresholds: ['red', {color: 'red', value: 'abc'}] },
    expected: { color_thresholds: [{color: 'red'}, {color: 'red'}] },
  },
  {
    description: 'value is a dict',
    config: { color_thresholds: ['red', {color: 'red', value: {abc: 123}}] },
    expected: { color_thresholds: [{color: 'red'}, {color: 'red'}] },
  },
  {
    description: 'value is an array',
    config: { color_thresholds: ['red', {color: 'red', value: [123, 456]}] },
    expected: { color_thresholds: [{color: 'red'}, {color: 'red'}] },
  },
]

VARIANTS.forEach((variant) => {
  describe("checkColorThresholds", () => {
    it(variant.description, () => {
      const config = {...variant.config};
      checkColorThresholds(config, 'config.color_thresholds');
      expect(config).toEqual(variant.expected);
    });
  });
});

describe("checkColorThresholds - shorthand for a color", () => {
  COLORS.forEach((color) => {
    it(`shorthand "color-only" [${color}] element`, () => {
      const config = {color_thresholds: [color]};
      checkColorThresholds(config, 'config.color_thresholds');
      const expected = [{ color: color }];
      expect(config.color_thresholds).toEqual(expected);
    });
  });
});

describe("checkColorThresholds - shorthand for a color (dict)", () => {
  COLORS.forEach((color) => {
    it(`shorthand "color-only" [${color}] dict element`, () => {
      const config = {color_thresholds: [{color}]};
      checkColorThresholds(config, 'config.color_thresholds');
      const expected = [{ color: color }];
      expect(config.color_thresholds).toEqual(expected);
    });
  });
});
