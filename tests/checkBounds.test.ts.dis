/**
 * Tests for checkBounds().
 *
 * The file is disabled (renamed to *.dis) & thus is not used during a build process;
 * remove the "dis" extension to use it locally in your VSCode devcontainer.
 */

import { assert, describe, it } from 'vitest';
import { checkBounds } from '../checkOption';

interface ConfigType {
  lower_bound?: number | string | any;
  upper_bound?: number | any;
};

const VARIANTS: any[] = [
  {
    description: 'undefined values',
    config: { },
    expected: { lowerBound: undefined, upperBound: undefined, lowerBoundParsed: undefined, upperBoundParsed: undefined },
  },
  {
    description: 'valid value for lower',
    config: { lower_bound: 123 },
    expected: { lowerBound: 123, upperBound: undefined, lowerBoundParsed: { value: 123, soft: false }, upperBoundParsed: undefined },
  },
  {
    description: 'valid value for upper',
    config: { upper_bound: 456 },
    expected: { lowerBound: undefined, upperBound: 456, lowerBoundParsed: undefined, upperBoundParsed: { value: 456, soft: false } },
  },
  {
    description: 'valid values for lower & upper',
    config: { lower_bound: 123, upper_bound: 456 },
    expected: { lowerBound: 123, upperBound: 456, lowerBoundParsed: { value: 123, soft: false }, upperBoundParsed: { value: 456, soft: false } },
  },
  {
    description: 'valid soft value for lower',
    config: { lower_bound: '~123' },
    expected: { lowerBound: '~123', upperBound: undefined, lowerBoundParsed: { value: 123, soft: true }, upperBoundParsed: undefined },
  },
  {
    description: 'valid soft value for upper',
    config: { upper_bound: '~456' },
    expected: { lowerBound: undefined, upperBound: '~456', lowerBoundParsed: undefined, upperBoundParsed: { value: 456, soft: true } },
  },
  {
    description: 'valid soft value for lower, valid soft value for upper',
    config: { lower_bound: '~123', upper_bound: '~456' },
    expected: { lowerBound: '~123', upperBound: '~456', lowerBoundParsed: { value: 123, soft: true }, upperBoundParsed: { value: 456, soft: true } },
  },
  {
    description: 'valid soft value for lower, valid value for upper',
    config: { lower_bound: '~123', upper_bound: 456 },
    expected: { lowerBound: '~123', upperBound: 456, lowerBoundParsed: { value: 123, soft: true }, upperBoundParsed: { value: 456, soft: false } },
  },
  {
    description: 'lower = upper',
    config: { lower_bound: 123, upper_bound: 123 },
    expected: { lowerBound: 123, upperBound: undefined, lowerBoundParsed: { value: 123, soft: false }, upperBoundParsed: undefined },
  },
  {
    description: 'lower = soft upper',
    config: { lower_bound: 123, upper_bound: '~123' },
    expected: { lowerBound: 123, upperBound: undefined, lowerBoundParsed: { value: 123, soft: false }, upperBoundParsed: undefined },
  },
  {
    description: 'soft lower = upper',
    config: { lower_bound: '~123', upper_bound: 123 },
    expected: { lowerBound: '~123', upperBound: undefined, lowerBoundParsed: { value: 123, soft: true }, upperBoundParsed: undefined },
  },
  {
    description: 'soft lower = soft upper',
    config: { lower_bound: '~123', upper_bound: '~123' },
    expected: { lowerBound: '~123', upperBound: undefined, lowerBoundParsed: { value: 123, soft: true }, upperBoundParsed: undefined },
  },
  {
    description: 'lower > upper',
    config: { lower_bound: 457, upper_bound: 456 },
    expected: { lowerBound: 457, upperBound: undefined, lowerBoundParsed: { value: 457, soft: false }, upperBoundParsed: undefined },
  },
  {
    description: 'lower > upper(string)',
    config: { lower_bound: 457, upper_bound: '456' },
    expected: { lowerBound: 457, upperBound: undefined, lowerBoundParsed: { value: 457, soft: false }, upperBoundParsed: undefined },
  },
  {
    description: 'lower(string) > upper',
    config: { lower_bound: '457', upper_bound: 456 },
    expected: { lowerBound: 457, upperBound: undefined, lowerBoundParsed: { value: 457, soft: false }, upperBoundParsed: undefined },
  },
  {
    description: 'lower(string) > upper(string)',
    config: { lower_bound: '457', upper_bound: '456' },
    expected: { lowerBound: 457, upperBound: undefined, lowerBoundParsed: { value: 457, soft: false }, upperBoundParsed: undefined },
  },
  {
    description: 'soft lower > upper',
    config: { lower_bound: '~457', upper_bound: 456 },
    expected: { lowerBound: '~457', upperBound: undefined, lowerBoundParsed: { value: 457, soft: true }, upperBoundParsed: undefined },
  },
  {
    description: 'soft lower > soft upper',
    config: { lower_bound: '~457', upper_bound: '~456' },
    expected: { lowerBound: '~457', upperBound: undefined, lowerBoundParsed: { value: 457, soft: true }, upperBoundParsed: undefined },
  },
  {
    description: 'soft lower > upper(string)',
    config: { lower_bound: '~457', upper_bound: '456' },
    expected: { lowerBound: '~457', upperBound: undefined, lowerBoundParsed: { value: 457, soft: true }, upperBoundParsed: undefined },
  },
];

describe("checkBounds", () => {
  VARIANTS.forEach((variant) => {
    it(`checkBounds: check [${JSON.stringify(variant)}], ${variant.description}`, () => {
      const yAxis = 'primary';
      const result = checkBounds(variant.config, yAxis);
      const expectedValue = variant.expected;
      assert.deepEqual(
        result,
        expectedValue,
      );
    });
  });

});
