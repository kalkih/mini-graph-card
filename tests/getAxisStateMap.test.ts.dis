/**
 * Tests for MiniGraphCard::_getAxisStateMap().
 *
 * The file is disabled (renamed to *.dis) & thus is not used during a build process;
 * remove the "dis" extension to use it locally in your VSCode devcontainer.
 */

// @vitest-environment jsdom
import { expect, describe, it, beforeEach } from 'vitest';
import MiniGraphCard from '../src/main';
import { getStringifiedValue } from '../src/utils';
import type { StateMapType, StateMapEntryType } from './types/stateMapTypes';
import type { ConfigType } from './types/configType';
import type { EntityConfigType } from './types/entityConfigType';

const MAP_STRINGS: StateMapEntryType[] = [
  { value: 'abc' },
  { value: 'def' },
  { value: 'ghi' },
];

const MAP_STRINGS_GLOBAL: StateMapEntryType[] = [
  ...MAP_STRINGS,
  { value: 'xxx' },
];

const MAP_NUMBERS: StateMapEntryType[] = [
  { value: 123, label: 'value_123' },
  { value: 456, label: 'value_456' },
  { value: 789, label: 'value_789' },
];

const STATE_MAP_STRICT_EMPTY: StateMapType = {
  map: [],
};

const STATE_MAP_RELAXED_EMPTY: StateMapType = {
  map: [],
  keep_values: true,
};

const STATE_MAP_STRICT: StateMapType = {
  map: MAP_STRINGS,
};

const STATE_MAP_STRICT_GLOBAL: StateMapType = {
  map: MAP_STRINGS_GLOBAL,
};

const STATE_MAP_RELAXED: StateMapType = {
  map: MAP_NUMBERS,
  keep_values: true,
};

/////////////////////////////////////////////////////////////////////////
const ENTITIES: EntityConfigType[] = [
  {},
  {},
  {},
  { y_axis: 'primary' },
  { y_axis: 'primary' },
  { y_axis: 'primary' },
  { y_axis: 'primary' },
  { y_axis: 'secondary' },
  { y_axis: 'secondary' },
  { y_axis: 'secondary' },
];
/////////////////////////////////////////////////////////////////////////
const ENTITIES_WITH_STATE_MAP_STRICT_EMPTY: EntityConfigType[] = [
  { state_map: STATE_MAP_STRICT_EMPTY },
  { state_map: STATE_MAP_STRICT_EMPTY },
  { state_map: STATE_MAP_STRICT_EMPTY },
];

const ENTITIES_WITH_STATE_MAP_RELAXED_EMPTY: EntityConfigType[] = [
  { state_map: STATE_MAP_RELAXED_EMPTY },
  { state_map: STATE_MAP_RELAXED_EMPTY },
  { state_map: STATE_MAP_RELAXED_EMPTY },
];
/////////////////////////////////////////////////////////////////////////
const ENTITIES_WITH_STATE_MAP_STRICT_EMPTY_PRIMARY: EntityConfigType[] = [
  { y_axis: 'primary', state_map: STATE_MAP_STRICT_EMPTY },
  { y_axis: 'primary', state_map: STATE_MAP_STRICT_EMPTY },
  { y_axis: 'primary', state_map: STATE_MAP_STRICT_EMPTY },
];

const ENTITIES_WITH_STATE_MAP_STRICT_EMPTY_SECONDARY: EntityConfigType[] = [
  { y_axis: 'secondary', state_map: STATE_MAP_STRICT_EMPTY },
  { y_axis: 'secondary', state_map: STATE_MAP_STRICT_EMPTY },
  { y_axis: 'secondary', state_map: STATE_MAP_STRICT_EMPTY },
];

const ENTITIES_WITH_STATE_MAP_RELAXED_EMPTY_PRIMARY: EntityConfigType[] = [
  { y_axis: 'primary', state_map: STATE_MAP_RELAXED_EMPTY },
  { y_axis: 'primary', state_map: STATE_MAP_RELAXED_EMPTY },
  { y_axis: 'primary', state_map: STATE_MAP_RELAXED_EMPTY },
];

const ENTITIES_WITH_STATE_MAP_RELAXED_EMPTY_SECONDARY: EntityConfigType[] = [
  { y_axis: 'secondary', state_map: STATE_MAP_RELAXED_EMPTY },
  { y_axis: 'secondary', state_map: STATE_MAP_RELAXED_EMPTY },
  { y_axis: 'secondary', state_map: STATE_MAP_RELAXED_EMPTY },
];
/////////////////////////////////////////////////////////////////////////
const ENTITIES_WITH_STATE_MAP_STRICT: EntityConfigType[] = [
  { state_map: STATE_MAP_STRICT },
  { state_map: STATE_MAP_STRICT },
  { state_map: STATE_MAP_STRICT },
];

const ENTITIES_WITH_STATE_MAP_RELAXED: EntityConfigType[] = [
  { state_map: STATE_MAP_RELAXED },
  { state_map: STATE_MAP_RELAXED },
  { state_map: STATE_MAP_RELAXED },
];
/////////////////////////////////////////////////////////////////////////
const ENTITIES_WITH_STATE_MAP_STRICT_PRIMARY: EntityConfigType[] = [
  { y_axis: 'primary', state_map: STATE_MAP_STRICT },
  { y_axis: 'primary', state_map: STATE_MAP_STRICT },
  { y_axis: 'primary', state_map: STATE_MAP_STRICT },
];

const ENTITIES_WITH_STATE_MAP_STRICT_SECONDARY: EntityConfigType[] = [
  { y_axis: 'secondary', state_map: STATE_MAP_STRICT },
  { y_axis: 'secondary', state_map: STATE_MAP_STRICT },
  { y_axis: 'secondary', state_map: STATE_MAP_STRICT },
];
/////////////////////////////////////////////////////////////////////////
const ENTITIES_WITH_STATE_MAP_RELAXED_PRIMARY: EntityConfigType[] = [
  { y_axis: 'primary', state_map: STATE_MAP_RELAXED },
  { y_axis: 'primary', state_map: STATE_MAP_RELAXED },
  { y_axis: 'primary', state_map: STATE_MAP_RELAXED },
];

const ENTITIES_WITH_STATE_MAP_RELAXED_SECONDARY: EntityConfigType[] = [
  { y_axis: 'secondary', state_map: STATE_MAP_RELAXED },
  { y_axis: 'secondary', state_map: STATE_MAP_RELAXED },
  { y_axis: 'secondary', state_map: STATE_MAP_RELAXED },
];
/////////////////////////////////////////////////////////////////////////
const ENTITIES_WITH_DIFF_STATE_MAP = [
  ...ENTITIES,
  ///
  ...ENTITIES_WITH_STATE_MAP_STRICT,
  ...ENTITIES_WITH_STATE_MAP_RELAXED,
  ///
  ...ENTITIES_WITH_STATE_MAP_STRICT_EMPTY,
  ...ENTITIES_WITH_STATE_MAP_RELAXED_EMPTY,
  ///
  ...ENTITIES_WITH_STATE_MAP_STRICT_PRIMARY,
  ...ENTITIES_WITH_STATE_MAP_STRICT_SECONDARY,
  ...ENTITIES_WITH_STATE_MAP_RELAXED_PRIMARY,
  ...ENTITIES_WITH_STATE_MAP_RELAXED_SECONDARY,
  ///
  ...ENTITIES_WITH_STATE_MAP_STRICT_EMPTY_PRIMARY,
  ...ENTITIES_WITH_STATE_MAP_STRICT_EMPTY_SECONDARY,
  ...ENTITIES_WITH_STATE_MAP_RELAXED_EMPTY_PRIMARY,
  ...ENTITIES_WITH_STATE_MAP_RELAXED_EMPTY_SECONDARY,
];

const ENTITIES_WITH_EMPTY_STATE_MAP = [
  ...ENTITIES,
  ///
  ...ENTITIES_WITH_STATE_MAP_STRICT_EMPTY,
  ...ENTITIES_WITH_STATE_MAP_RELAXED_EMPTY,
  ...ENTITIES_WITH_STATE_MAP_STRICT_EMPTY_PRIMARY,
  ...ENTITIES_WITH_STATE_MAP_STRICT_EMPTY_SECONDARY,
  ...ENTITIES_WITH_STATE_MAP_RELAXED_EMPTY_PRIMARY,
  ...ENTITIES_WITH_STATE_MAP_RELAXED_EMPTY_SECONDARY,
];

/////////////////////////////////////////////////////////////////////////

interface ResultType {
  primary: StateMapType | null;
  secondary: StateMapType | null;
};

const RESULT_NULL: ResultType  = {
  primary: null,
  secondary: null,
};

type TemplatedDescrType = (
  mode: string,
  empty: string,
  axis: string,
  note?: string,
) => string;

interface VariantType {
  descr: string | TemplatedDescrType;
  config?: ConfigType;
  expected?: ResultType;
  expected_global_primary?: boolean;
  expected_global_secondary?: boolean;
};

const VARIANTS: VariantType[] = [
  {
    descr: 'no state_map',
    config: {
      entities: ENTITIES,
    },
    expected: RESULT_NULL,
    expected_global_primary: true,
    expected_global_secondary: true,
  },
  {
    descr: 'state_map per-entity, many instances',
    config: {
      entities: ENTITIES_WITH_DIFF_STATE_MAP,
    },
    expected: RESULT_NULL,
  },
  {
    descr: 'state_map per-entity, many instances (all empty)',
    config: {
      entities: ENTITIES_WITH_EMPTY_STATE_MAP,
    },
    expected: RESULT_NULL,
    expected_global_primary: true,
    expected_global_secondary: true,
  },
];
/////////////////////////////////////////////////////////////////////////////////////////
const VARIANTS_SINGLE_ENTITY_WITH_STATE_MAP: VariantType[] = [
  {
    descr: (mode, empty, axis, note) =>
      `${mode} state_map per-entity${empty}, only one ${axis} entity${note}`,
  },
];
/////////////////////////////////////////////////////////////////////////////////////////
const VARIANTS_ONE_INSTANCE: VariantType[] = [
  {
    descr: (mode, empty, axis) => `state_map per-entity, ONE instance (${mode}, ${axis}${empty}), many ${axis} entities`,
  },
];
/////////////////////////////////////////////////////////////////////////////////////////

describe("MiniGraphCard::_getAxisStateMap()", () => {
  let card: MiniGraphCard;

  beforeEach(() => {
    card = new MiniGraphCard();
    card._visibleEntitiesCache = undefined;
    card._primaryYaxisEntitiesCache = undefined;
    card._secondaryYaxisEntitiesCache = undefined;
  });

  for (let globalIndex = 0; globalIndex < 5; globalIndex += 1) {
    // global state_map: no, strict, strict empty, relaxed, relaxed empty
    let mainDescr = '';
    let stateMap: StateMapType;
    const ignoreGlobalStateMap = globalIndex !== 1;
    switch (globalIndex) {
      case 0:
        mainDescr = "No global state_map";
        stateMap = {};
        break;
      case 1:
        mainDescr = "global strict state_map";
        stateMap = STATE_MAP_STRICT_GLOBAL;
        break;
      case 2:
        mainDescr = "global strict state_map (empty map)";
        stateMap = STATE_MAP_STRICT_EMPTY;
        break;
      case 3:
        mainDescr = "global relaxed state_map";
        stateMap = STATE_MAP_RELAXED;
        break;
      case 4:
        mainDescr = "global relaxed state_map (empty map)";
        stateMap = STATE_MAP_RELAXED_EMPTY;
        break;
    }
    describe(mainDescr, () => {
      VARIANTS.forEach((variant) => {
        it(variant.descr, () => {
          card.config = { ...variant.config, ...{ state_map: stateMap } }
          const stateMapConfig = card._getAxisStateMap();
          const expectedPrimary = !ignoreGlobalStateMap && variant.expected_global_primary
            ? STATE_MAP_STRICT_GLOBAL
            : variant.expected!.primary;
          const expectedSecondary = !ignoreGlobalStateMap && variant.expected_global_secondary
            ? STATE_MAP_STRICT_GLOBAL
            : variant.expected!.secondary;
          const expected = { primary: expectedPrimary, secondary: expectedSecondary };
          // console.log(mainDescr, ' || ', variant.descr, card.config, expected);
          expect(stateMapConfig).toEqual(expected);
        });
      });

      for (let axisIndex = 0; axisIndex < 2; axisIndex += 1) {
        // primary, secondary
        const axis = axisIndex === 0
          ? 'primary'
          : 'secondary';

        for (let modeIndex = 0; modeIndex < 2; modeIndex += 1) {
          // strict or relaxed
          const keepValues = modeIndex === 0
            ? undefined
            : true;
          const mappingType = modeIndex === 0
            ? 'strict'
            : 'relaxed';

          for (let emptyIndex = 0; emptyIndex < 2; emptyIndex += 1) {
            // non-empty or empty map
            const isMapEmpty = emptyIndex === 1;
            const emptyLabel = !isMapEmpty
              ? ''
              : ', empty map';
            const map = !isMapEmpty
              ? keepValues
                ? MAP_NUMBERS
                : MAP_STRINGS
              : [];

            VARIANTS_SINGLE_ENTITY_WITH_STATE_MAP.forEach((variant) => {
              const oppositeAxis = axis === 'primary'
                ? 'secondary'
                : 'primary';
              for (let moreEntitiesIndex = 0; moreEntitiesIndex < 2; moreEntitiesIndex += 1) {
                // there is none or some entities on an opposite axis
                const moreEntitiesNote = moreEntitiesIndex === 1
                  ? ` (there are some ${oppositeAxis} entities)`
                  : '';
                const descr: string = (variant.descr as TemplatedDescrType)(mappingType, emptyLabel, axis, moreEntitiesNote);
                it(descr, () => {
                  const baseConfig = {
                    entities: [
                      { y_axis: axis, state_map: { map, keep_values: keepValues } },
                      ...(moreEntitiesIndex !== 1
                          ? [
                            { y_axis: oppositeAxis },
                            { y_axis: oppositeAxis },
                            { y_axis: oppositeAxis },
                          ]
                          : []
                        ),
                    ],
                  };
                  card.config = {
                    ...baseConfig,
                    ...{ state_map: stateMap },
                  }
                  const stateMapConfig = card._getAxisStateMap();
                  const expectedPrimary = (axis === 'primary' && !isMapEmpty && mappingType === 'strict')
                    ? STATE_MAP_STRICT
                    : !ignoreGlobalStateMap
                      ? STATE_MAP_STRICT_GLOBAL
                      : null;
                  const expectedSecondary = (axis === 'secondary' && !isMapEmpty && mappingType === 'strict')
                    ? STATE_MAP_STRICT
                    : !ignoreGlobalStateMap
                      ? STATE_MAP_STRICT_GLOBAL
                      : null;
                  const expected = { primary: expectedPrimary, secondary: expectedSecondary };
                  // console.log(mainDescr, ' || ', descr, card.config, expected);
                  expect(stateMapConfig).toEqual(expected);
                });
              }
            });

            VARIANTS_ONE_INSTANCE.forEach((variant) => {
              const descr: string = (variant.descr as TemplatedDescrType)(mappingType, emptyLabel, axis);
              it(descr, () => {
                card.config = {
                  entities: [
                    ...ENTITIES,
                    { y_axis: axis, state_map: { map, keep_values: keepValues } },
                  ],
                  ...{ state_map: stateMap },
                };
                const stateMapConfig = card._getAxisStateMap();
                const expectedPrimary = !ignoreGlobalStateMap
                  && (axis === 'secondary' || (axis === 'primary' && isMapEmpty))
                  ? STATE_MAP_STRICT_GLOBAL
                  : null;
                const expectedSecondary = !ignoreGlobalStateMap
                  && (axis === 'primary' || (axis === 'secondary' && isMapEmpty))
                  ? STATE_MAP_STRICT_GLOBAL
                  : null;
                const expected = { primary: expectedPrimary, secondary: expectedSecondary };
                // console.log(mainDescr, ' || ', descr, card.config, expected);
                expect(stateMapConfig).toEqual(expected);
              });
            });
          }
        }
      }
    });
  }
});
