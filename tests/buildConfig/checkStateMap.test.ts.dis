    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def', tolerance: 0}, {value: 'xyz'}], keep_values: true},
  },
  {
    descr: 'tolerance is a string & >0',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def', tolerance: '1'}, {value: 'xyz'}]},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}]},
  },
  {
    descr: 'tolerance is a string & >0 (keep_values=false)',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def', tolerance: '1'}, {value: 'xyz'}], keep_values: false},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}], keep_values: false},
  },
  {
    descr: 'tolerance is a string & >0 (keep_values=true)',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def', tolerance: '1'}, {value: 'xyz'}], keep_values: true},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def', tolerance: 1}, {value: 'xyz'}], keep_values: true},
  },
