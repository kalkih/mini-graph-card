    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def', tolerance: 1}, {value: 'xyz'}], keep_values: true},
  },
];

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
VARIANTS.forEach((variant) => {
  describe(variant.descr, () => {
    let map = variant.map;
    let config: ConfigType;
    let config_new: ConfigType;
    let expected = variant.expected;

    beforeEach(() => {
      config = { state_map: map };
      config_new = { state_map: { map } };
    });

    TEST_TYPE.forEach((test, index) => {
      it(test, () => {
        let cfg = index === 0
          ? config
          : config_new;
        if (index !== 1) {
          cfg = migrateStateMapConfig(cfg) as ConfigType;
        }
        checkStateMap(cfg, 'config');
        expect(cfg.state_map).toEqual(expected);
      });
    });
  });
});
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
DIFF_VALUES.forEach((value) => {
  const VALUES = [
    {
      descr: `shorthand "value-only" [${value}] element`,
      map: [value],
      expected: {map: [{ value: String(value) }]},
    },
    {
      descr: `"value-only" [${value}] dict element`,
      map: [{ value }],
      expected: {map: [{ value: String(value) }]},
    },
  ];
  VALUES.forEach((variant) => {
    describe(variant.descr, () => {
      let map = [ ...variant.map ];
      let config: ConfigType;
      let config_new: ConfigType;

      beforeEach(() => {
        config = { state_map: map };
        config_new = { state_map: { map } };
      });

      TEST_TYPE.forEach((test, index) => {
        it(test, () => {
          let cfg = index === 0
            ? config
            : config_new;
          if (index !== 1) {
            cfg = migrateStateMapConfig(cfg) as ConfigType;
          }
          checkStateMap(cfg, 'config');
          expect(cfg.state_map).toEqual(variant.expected);
        });
      });
    });
  });
});
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
VARIANTS_ONLY_NEW.forEach((variant) => {
  describe(variant.descr, () => {
    let config_new: ConfigType;
    let expected = variant.expected;

    beforeEach(() => {
      config_new = { state_map: {...variant.stateMap} };
    });

    TEST_TYPE.forEach((test, index) => {
      if (index === 0) {
        // check only new structure
        return;
      }
      it(test, () => {
        if (index !== 1) {
          config_new = migrateStateMapConfig(config_new) as ConfigType;
        }
        checkStateMap(config_new, 'config');
        expect(config_new.state_map).toEqual(expected);
      });
    });
  });
});

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// testing overlapping
describe("Zones overlapping", () => {
  it("min/max: [0,19) & [20,50): ranges do not overlap", () => {
    const config = {
      state_map: {
        keep_values: true,
        map: [
          { min: 0, max: 19 }, // [0 .. 19)
          { min: 20, max: 50 }, // [20 .. 50)
        ]
      }
    };
    const expected = JSON.parse(JSON.stringify(config));
    checkStateMap(config, "config");
    expect(config).toEqual(expected);
  });

  it("min/max: [0,20) & [20,50): ranges do not overlap, but touch", () => {
    const config = {
      state_map: {
        keep_values: true,
        map: [
          { min: 0, max: 20 }, // [0 .. 20)
          { min: 20, max: 50 }, // [20 .. 50)
        ]
      }
    };
    const expected = JSON.parse(JSON.stringify(config));
    checkStateMap(config, "config");
    expect(config).toEqual(expected);
  });

  it("min/max: [0,21) & [20,50): ranges overlap", () => {
    const config = {
      state_map: {
        keep_values: true,
        map: [
          { min: 0, max: 21 }, // [0 .. 21)
          { min: 20, max: 50 }, // [20 .. 50)
        ]
      }
    };
    const expected = {
      state_map: {
        keep_values: true,
        map: [
          { min: 0, max: 21 }, // [0 .. 21)
        ]
      }
    };
    checkStateMap(config, "config");
    expect(config).toEqual(expected);
  });
  ////////////////////////////////////////////////////////////////////////////////
  it("tolerance: [0..20] & [20..50]: ranges do not overlap", () => {
    const config = {
      state_map: {
        keep_values: true,
        map: [
          { value: 9.9, tolerance: 10 }, // [-0.1 .. 19.9]
          { value: 35, tolerance: 15 }, // [20 .. 50]
        ]
      }
    };
    const expected = {
      state_map: {
        keep_values: true,
        map: [
          { value: '9.9', tolerance: 10 }, // [-0.1 .. 19.9]
          { value: '35', tolerance: 15 }, // [20 .. 50]
        ]
      }
    };
    checkStateMap(config, "config");
    expect(config).toEqual(expected);
  });

  it("tolerance: [0..20] & [20..50]: ranges overlap", () => {
    const config = {
      state_map: {
        keep_values: true,
        map: [
          { value: 10, tolerance: 10 }, // [0 .. 20]
          { value: 35, tolerance: 15 }, // [20 .. 50]
        ]
      }
    };
    const expected = {
      state_map: {
        keep_values: true,
        map: [
          { value: '10', tolerance: 10 }, // [0 .. 20]
        ]
      }
    };
    checkStateMap(config, "config");
    expect(config).toEqual(expected);
  });
  //////////////////////////////////////////////////////////////////////////////
  it("value, min/max: 19.9 & [20,50): ranges do not overlap", () => {
    const config = {
      state_map: {
        keep_values: true,
        map: [
          { value: 19.9 },
          { min: 20, max: 50 }, // [20 .. 50)
        ]
      }
    };
    const expected = {
      state_map: {
        keep_values: true,
        map: [
          { value: '19.9' },
          { min: 20, max: 50 }, // [20 .. 50)
        ]
      }
    };
    checkStateMap(config, "config");
    expect(config).toEqual(expected);
  });

  it("value, min/max: 20 & [20,50): ranges overlap", () => {
    const config = {
      state_map: {
        keep_values: true,
        map: [
          { value: 20 },
          { min: 20, max: 50 }, // [20 .. 50)
        ]
      }
    };
    const expected = {
      state_map: {
        keep_values: true,
        map: [
          { value: '20' },
        ]
      }
    };
    checkStateMap(config, "config");
    expect(config).toEqual(expected);
  });
  ////////////////////////////////////////////////////////////////////////////////
  it("tolerance: 19 & [20..50]: ranges do not overlap", () => {
    const config = {
      state_map: {
        keep_values: true,
        map: [
          { value: 19 },
          { value: 35, tolerance: 15 }, // [20 .. 50]
        ]
      }
    };
    const expected = {
      state_map: {
        keep_values: true,
        map: [
          { value: '19' },
          { value: '35', tolerance: 15 }, // [20 .. 50]
        ]
      }
    };
    checkStateMap(config, "config");
    expect(config).toEqual(expected);
  });

  it("tolerance: 20 & [20..50]: ranges overlap", () => {
    const config = {
      state_map: {
        keep_values: true,
        map: [
          { value: 20 },
          { value: 35, tolerance: 15 }, // [20 .. 50]
        ]
      }
    };
    const expected = {
      state_map: {
        keep_values: true,
        map: [
          { value: '20' },
        ]
      }
    };
    checkStateMap(config, "config");
    expect(config).toEqual(expected);
  });
});

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// testing templates in "label"
describe("Templated label", () => {
  it("Auto-generated labels (strict)", () => {
    const config: ConfigType = {
      state_map: {
        map: [
          { value: '200' },
          { value: 100 },
        ]
      }
    };
    checkStateMap(config, "config");
    expect((config.state_map as StateMapType)!.map![0].label).toBeUndefined();
    expect((config.state_map as StateMapType)!.map![1].label).toBeUndefined();
  });

  it("Auto-generated labels (relaxed)", () => {
    const config: ConfigType = {
      state_map: {
        keep_values: true,
        map: [
          { min: 15, max: 25 },
          { value: 100 },
        ]
      }
    };
    checkStateMap(config, "config");
    expect((config.state_map as StateMapType)!.map![0].label).toBeUndefined();
    expect((config.state_map as StateMapType)!.map![1].label).toBeUndefined();
  });

  it("Templated labels (relaxed)", () => {
    const config: ConfigType = {
      state_map: {
        keep_values: true,
        map: [
          { min: 15, max: 25, label: "xxx [${min}%..${max}%]" },
        ]
      }
    };
    checkStateMap(config, "config");
    expect((config.state_map as StateMapType)!.map![0].label).toBe("xxx [${min}%..${max}%]");
  });

  it("Templated labels (relaxed), value is defined along with min/max", () => {
    const config: ConfigType = {
      state_map: {
        keep_values: true,
        map: [
          { value: 100, min: 15, max: 25, label: "xxx ${value}, [${min}%..${max}%]" },
        ]
      }
    };
    checkStateMap(config, "config");
    // label is generated, but min/max are unset to undefined
    expect((config.state_map as StateMapType)!.map![0].label).toBe("xxx ${value}, [${min}%..${max}%]");
    expect((config.state_map as StateMapType)!.map![0].min).toBeUndefined();
    expect((config.state_map as StateMapType)!.map![0].max).toBeUndefined();
    expect((config.state_map as StateMapType)!.map![0].value).toBe("100");
  });
});
