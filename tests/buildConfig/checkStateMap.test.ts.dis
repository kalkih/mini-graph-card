/**
 * Tests for checkStateMap().
 *
 * The file is disabled (renamed to *.dis) & thus is not used during a build process;
 * remove the "dis" extension to use it locally in your VSCode devcontainer.
 */

import { expect, describe, it, beforeEach } from 'vitest';
import { checkStateMap } from '../../src/checkOption';
import { migrateStateMapConfig } from '../../src/migrate';
import type { StateMapType } from '../types/stateMapTypes';
import type { ConfigType } from '../types/configType';

const DIFF_VALUES: any[] = [
  "abc",
  "123",
  "-123",
  "0",
  123,
  -123,
  0,
  123.456,
  -123.456,
];

const TEST_TYPE: string[] = [
  "old structure",
  "new structure",
  "new structure, with migration",
];

const mapOK = [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}];

const VARIANTS: any[] = [
  {
    descr: 'check for undefined',
    stateMap: {},
    expected: {map: []},
  },
  {
    descr: 'check for null',
    stateMap: null,
    expected: {map: []},
  },
  ///////////////////////////////////////////////////////////////
  {
    descr: 'if not an array (number) -> unsetting to []',
    map: 123,
    expected: {map: []},
  },
  {
    descr: 'if not an array (string) -> unsetting to []',
    map: 'abc',
    expected: {map: []},
  },
  {
    descr: 'if not an array (dict) -> unsetting to []',
    map: {abc: 'xxx', def: 123},
    expected: {map: []},
  },
  ///////////////////////////////////////////////////////////////////
  {
    descr: 'value is missing',
    map: ['abc', {label: 'xyz'}, {}, 'def'],
    expected: {map: [{value: 'abc'}, {value: 'def'}]},
  },
  {
    descr: 'value is not a string or a number',
    map: [{value: 'abc', label: 'abc'}, {value: []}, {value: {}}, {value: 'def', label: 'def'}],
    expected: {map: mapOK},
  },
  ///////////////////////////////////////////////////////////////////
  {
    descr: 'value is undefined',
    map: [{value: 'abc', label: 'abc'}, {value: undefined}, {value: 'def', label: 'def'}],
    expected: {map: mapOK},
  },
  {
    descr: 'value is null',
    map: [{value: 'abc', label: 'abc'}, {value: null}, {value: 'def', label: 'def'}],
    expected: {map: mapOK},
  },
  ///////////////////////////////////////////////////////////////////
  {
    descr: 'label is not a string or a number (array)',
    map: [...mapOK, {value: 'xyz', label: []}],
    expected: {map: [...mapOK, {value: 'xyz'}]},
  },
  {
    descr: 'label is not a string or a number (dict)',
    map: [...mapOK, {value: 'xyz', label: {}}],
    expected: {map: [...mapOK, {value: 'xyz'}]},
  },
  ///////////////////////////////////////////////////////////////////
  {
    descr: 'label is undefined',
    map: [...mapOK, {value: 'xyz'}],
    expected: {map: [...mapOK, {value: 'xyz'}]},
  },
  {
    descr: 'label is null',
    map: [...mapOK, {value: 'xyz', label: null}],
    expected: {map: [...mapOK, {value: 'xyz'}]},
  },
];

const VARIANTS_ONLY_NEW: any[] = [
  {
    descr: 'keep_values = undefined',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}]},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}]},
  },
  {
    descr: 'keep_values = false',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}], keep_values: false},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}], keep_values: false},
  },
  {
    descr: 'keep_values = something',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}], keep_values: 123},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}], keep_values: true},
  },
  {
    descr: 'keep_values = true',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}], keep_values: true},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}], keep_values: true},
  },
  /////////////////////////////////////////////////////////////////
  {
    descr: 'min is a string & not a number (value is defined)',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def', min: 'www', max: 1000}, {value: 'xyz'}]},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}]},
  },
  {
    descr: 'min is a string & not a number (keep_values=false) (value is defined)',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def', min: 'www', max: 1000}, {value: 'xyz'}], keep_values: false},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}], keep_values: false},
  },
  {
    descr: 'min is a string & not a number (keep_values=true) (value is defined)',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def', min: 'www', max: 1000}, {value: 'xyz'}], keep_values: true},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}], keep_values: true},
  },
  {
    descr: 'min & max are OK (keep_values=true) (value is defined)',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def', min: 10, max: 1000}, {value: 'xyz'}], keep_values: true},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'def', label: 'def'}, {value: 'xyz'}], keep_values: true},
  },
  /////////////////////////////////////////////////////////////////
  {
    descr: 'min is a string & not a number (value is undefined)',
    stateMap: {map: [{value: 'abc', label: 'abc'}, {label: 'def', min: 'www', max: 1000}, {value: 'xyz'}]},
    expected: {map: [{value: 'abc', label: 'abc'}, {value: 'xyz'}]},
  },
  {
    descr: 'min is a string & not a number (keep_values=false) (value is undefined)',
