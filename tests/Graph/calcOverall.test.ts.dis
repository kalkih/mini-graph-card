/**
 * Tests for Graph._calcOverall() method.
 *
 * The file is disabled (renamed to *.dis) & thus is not used during a build process;
 * remove the "dis" extension to use it locally in your VSCode devcontainer.
 */

import { expect, describe, it, beforeEach } from 'vitest';
import Graph from '../../src/graph';
import { aggregateFuncMap } from '../../src/aggregate';
import { GRAPH_SETTINGS } from './graph';

type AggregateKey = keyof typeof aggregateFuncMap;

const RESULT_AVG = 5.1;

const EXPECTED: Record<AggregateKey, number> = {
  avg: RESULT_AVG,
  median: 15.15,
  min: -50.3,
  max: 40.4,
  sum: 20.4,
  first: 10.1,
  last: 40.4,
  delta: 90.7,
  diff: 30.3,
};

const FUNCS = Object.keys(aggregateFuncMap) as AggregateKey[];

describe("Graph._calcOverall()", () => {
  let graph: any;
  const setAggregateFunc = (func?: any, funcOverall?: any) => {
    graph._aggregateFuncName = func;
    graph._calcPoint = aggregateFuncMap[func as AggregateKey] || aggregateFuncMap['avg'];

    graph._overallAggregateFuncName = funcOverall;
    graph._overallAggregateFunc = aggregateFuncMap[funcOverall as AggregateKey] || graph._calcPoint;
  };

  beforeEach(() => {
    graph = new Graph({
      width: GRAPH_SETTINGS.width,
      height: GRAPH_SETTINGS.height,
      margin: GRAPH_SETTINGS.margin,
    });
    graph._history = [{ state: "10.1" }, { state: "20.2" }, { state: "-50.3" }, { state: "40.4" }];
  });

  it("empty history", () => {
    graph._history = [];
    const result = graph._calcOverall();
    expect(result).toBeUndefined();
  });

  it("default aggregateFunc", () => {
    const result = graph._calcOverall();
    expect(result).toEqual(RESULT_AVG);
  });

  it("invalid aggregateFunc", () => {
    setAggregateFunc('xxx');
    const result = graph._calcOverall();
    expect(result).toEqual(RESULT_AVG);
  });

  describe("use aggregateFuncName if overallAggregateFuncName is not defined", () => {
    for (let funcIndex = 0; funcIndex < FUNCS.length; funcIndex += 1) {
      const funcName = FUNCS[funcIndex];
      const expected = EXPECTED[funcName];

      it(`common ${funcName}, overall undefined`, () => {
        setAggregateFunc(funcName);
        // console.log(graph);
        const result = graph._calcOverall();
        if (['max', 'min', 'last', 'first'].includes(funcName)) {
          expect(result).toEqual(expected);
        } else {
          expect(result).toBeCloseTo(expected, 6);
        }
        expect(graph._aggregateFuncName).toEqual(funcName);
        expect(graph._calcPoint).toEqual(aggregateFuncMap[funcName]);
        expect(graph._overallAggregateFuncName).toBeUndefined();
        expect(graph._overallAggregateFunc).toEqual(aggregateFuncMap[funcName]);
      });
    }
  });

  describe("use overallAggregateFuncName if defined, aggregateFuncName is default", () => {
    for (let overallFuncIndex = 0; overallFuncIndex < FUNCS.length; overallFuncIndex += 1) {
      const overallFuncName = FUNCS[overallFuncIndex];
      const expected = EXPECTED[overallFuncName];

      it(`common undefined, overall ${overallFuncName}`, () => {
        setAggregateFunc(undefined, overallFuncName);
        // console.log(graph);
        const result = graph._calcOverall();
        if (['max', 'min', 'last', 'first'].includes(overallFuncName)) {
          expect(result).toEqual(expected);
        } else {
          expect(result).toBeCloseTo(expected, 6);
        }
        expect(graph._aggregateFuncName).toEqual(undefined);
        expect(graph._calcPoint).toEqual(aggregateFuncMap['avg']);
        expect(graph._overallAggregateFuncName).toEqual(overallFuncName);
        expect(graph._overallAggregateFunc).toEqual(aggregateFuncMap[overallFuncName]);
      });
    }
  });

  describe("use different aggregateFuncName & overallAggregateFuncName", () => {
    for (let funcIndex = 0; funcIndex < FUNCS.length; funcIndex += 1) {
      const funcName = FUNCS[funcIndex];
      for (let overallFuncIndex = 0; overallFuncIndex < FUNCS.length; overallFuncIndex += 1) {
        const overallFuncName = FUNCS[overallFuncIndex];
        const expected = EXPECTED[overallFuncName];

        it(`common ${funcName}, overall ${overallFuncName}`, () => {
          setAggregateFunc(funcName, overallFuncName);
          // console.log(graph);
          const result = graph._calcOverall();
          if (['max', 'min', 'last', 'first'].includes(overallFuncName)) {
            expect(result).toEqual(expected);
          } else {
            expect(result).toBeCloseTo(expected, 6);
          }
          expect(graph._aggregateFuncName).toEqual(funcName);
          expect(graph._calcPoint).toEqual(aggregateFuncMap[funcName]);
          expect(graph._overallAggregateFuncName).toEqual(overallFuncName);
          expect(graph._overallAggregateFunc).toEqual(aggregateFuncMap[overallFuncName]);
        });
      }
    }
  });
});
